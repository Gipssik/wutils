// Wutils settings window.
//
// The UI is data-driven: Rust sends a list of pages for the sidebar and a flat
// list of `SettingItem`s for the current page (or for search results). Adding a
// feature means adding items in Rust; this file only changes when a new *kind*
// of control is needed.

import { ComboBox, Button, LineEdit, ScrollView, Palette } from "std-widgets.slint";

export enum ItemKind { header, toggle, choice, button, info }

export struct SettingItem {
    id: string,
    kind: ItemKind,
    title: string,
    description: string,
    // Small pill next to the title, e.g. "Requires classic context menu".
    badge: string,
    // Page title; shown above the card in search results.
    page: string,
    enabled: bool,
    checked: bool,
    choices: [string],
    current: int,
    // Button label for `button` items.
    action: string,
}

export struct NavPage {
    title: string,
    icon: string,
}

export struct Banner {
    visible: bool,
    text: string,
    action: string,
    error: bool,
}

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window: dark ? #202020 : #f3f3f3;
    out property <color> card: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-hover: dark ? #323232 : #f6f6f6;
    out property <color> card-border: dark ? #1d1d1d : #e5e5e5;
    out property <color> nav-hover: dark ? #2d2d2d : #eaeaea;
    out property <color> nav-selected: dark ? #2d2d2d : #e9e9e9;
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5d5d5d;
    out property <color> text-disabled: dark ? #787878 : #a0a0a0;
    out property <color> info-bg: dark ? #3b2a1e : #fdeee3;
    out property <color> error-bg: dark ? #442726 : #fde7e9;
    // Brand orange (the icon's #F7630C). The app's own accent instead of the
    // system one, so switches and buttons match the logo. In light mode it's a
    // touch darker so white text on it stays readable; dark mode uses a lighter
    // tint with dark text, as Fluent does.
    out property <color> brand: #f7630c;
    out property <color> accent: dark ? #ff8c42 : #e8590c;
    out property <color> accent-hover: dark ? #ff9d5c : #d65108;
    out property <color> accent-pressed: dark ? #f07f35 : #c44a07;
    out property <color> on-accent: dark ? #1a1a1a : #ffffff;
    out property <color> control-hover: dark ? #ffffff0f : #0000000a;
}

component Icon inherits Text {
    font-family: "Segoe Fluent Icons";
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Same mark as the app icon: a plain orange W.
component Logo inherits Text {
    text: "W";
    color: Theme.brand;
    font-family: "Segoe UI";
    font-size: 22px;
    font-weight: 700;
    vertical-alignment: center;
}

// Fluent-style toggle in the brand accent (std `Switch` follows the system accent).
component ToggleSwitch inherits Rectangle {
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);

    width: 40px;
    height: 20px;
    border-radius: 10px;
    border-width: checked ? 0px : 1px;
    border-color: enabled ? Theme.text-secondary : Theme.text-disabled;
    background: !checked ? (touch.has-hover && enabled ? Theme.control-hover : transparent)
        : !enabled ? Theme.text-disabled
        : touch.pressed ? Theme.accent-pressed
        : touch.has-hover ? Theme.accent-hover : Theme.accent;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { toggle(); }

    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    Rectangle {
        // The knob grows on hover and stretches while pressed, like Windows 11.
        width: touch.pressed ? 17px : touch.has-hover ? 14px : 12px;
        height: touch.has-hover || touch.pressed ? 14px : 12px;
        border-radius: self.height / 2;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        background: root.checked ? Theme.on-accent : root.enabled ? Theme.text-secondary : Theme.text-disabled;
        animate x, width, height { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { toggle(); }
    }
}

// Primary (filled) button in the brand accent.
component AccentButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 32px;
    min-width: 96px;
    border-radius: 4px;
    background: touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: Theme.on-accent;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <bool> selected;
    callback clicked;

    height: 38px;
    border-radius: 5px;
    background: selected ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;
    accessible-role: tab;
    accessible-label: title;

    Rectangle {
        x: 0;
        width: 3px;
        height: selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 14px;
        spacing: 14px;
        Icon {
            text: root.icon;
            font-size: 16px;
            width: 18px;
            color: Theme.text;
        }
        Text {
            text: root.title;
            font-size: 14px;
            vertical-alignment: center;
            color: Theme.text;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    border-radius: 4px;
    background: Theme.dark ? #3a3a3a : #e6e6e6;
    height: 18px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: 11px;
            vertical-alignment: center;
            color: Theme.text-secondary;
        }
    }
}

component SettingCard inherits Rectangle {
    in property <SettingItem> item;
    in property <bool> show-page;
    in-out property <bool> checked;
    in-out property <int> current;
    callback toggled(bool);
    callback selected(int);
    callback action();

    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: hover.has-hover && item.enabled ? Theme.card-hover : Theme.card;

    hover := TouchArea {
        // Clicking anywhere on a toggle card flips it, like Windows Settings.
        clicked => {
            if (item.kind == ItemKind.toggle && item.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 13px;
        padding-bottom: 13px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            if root.show-page && item.page != "": Text {
                text: item.page;
                font-size: 11px;
                color: Theme.accent;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: item.title;
                    font-size: 14px;
                    vertical-alignment: center;
                    color: item.enabled ? Theme.text : Theme.text-disabled;
                }
                if item.badge != "": VerticalLayout {
                    alignment: center;
                    Badge { text: item.badge; }
                }
            }
            if item.description != "": Text {
                text: item.description;
                font-size: 12px;
                wrap: word-wrap;
                color: item.enabled ? Theme.text-secondary : Theme.text-disabled;
            }
        }

        if item.kind == ItemKind.toggle: VerticalLayout {
            alignment: center;
            ToggleSwitch {
                checked <=> root.checked;
                enabled: item.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
        if item.kind == ItemKind.choice: VerticalLayout {
            alignment: center;
            ComboBox {
                min-width: 220px;
                model: item.choices;
                enabled: item.enabled;
                current-index <=> root.current;
                selected => { root.selected(self.current-index); }
            }
        }
        if item.kind == ItemKind.button: VerticalLayout {
            alignment: center;
            Button {
                text: item.action;
                enabled: item.enabled;
                clicked => { root.action(); }
            }
        }
    }
}

component ItemView inherits VerticalLayout {
    in property <SettingItem> item;
    in property <bool> show-page;
    in-out property <bool> checked;
    in-out property <int> current;
    callback toggled(bool);
    callback selected(int);
    callback action();

    if item.kind == ItemKind.header: Text {
        text: item.title;
        font-size: 14px;
        font-weight: 600;
        color: Theme.text;
        // Space above section headers; the layout spacing adds the rest.
        height: self.preferred-height + 18px;
        vertical-alignment: bottom;
    }
    if item.kind != ItemKind.header: SettingCard {
        item: root.item;
        show-page: root.show-page;
        checked <=> root.checked;
        current <=> root.current;
        toggled(v) => { root.toggled(v); }
        selected(i) => { root.selected(i); }
        action => { root.action(); }
    }
}

component BannerBar inherits Rectangle {
    in property <Banner> banner;
    callback action();

    border-radius: 6px;
    background: banner.error ? Theme.error-bg : Theme.info-bg;
    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 12px;
        Icon {
            text: banner.error ? "\u{E783}" : "\u{E946}";
            font-size: 16px;
            color: Theme.text;
        }
        Text {
            text: banner.text;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: Theme.text;
        }
        if banner.action != "": VerticalLayout {
            alignment: center;
            AccentButton {
                text: banner.action;
                clicked => { root.action(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Wutils";
    icon: @image-url("../../../assets/wutils.png");
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 700px;
    min-height: 460px;
    background: Theme.window;
    default-font-family: "Segoe UI Variable Text";

    in property <[NavPage]> pages;
    in property <int> current-page;
    in property <bool> searching;
    in property <string> heading;
    in property <[SettingItem]> items;
    in property <Banner> banner;
    in property <string> version;

    callback page-selected(int);
    callback search-changed(string);
    callback toggled(string, bool);
    callback choice-selected(string, int);
    callback action(string);
    callback banner-action();

    HorizontalLayout {
        // Sidebar
        VerticalLayout {
            width: 280px;
            padding: 14px;
            padding-top: 12px;
            spacing: 4px;

            HorizontalLayout {
                alignment: start;
                padding-left: 6px;
                padding-bottom: 10px;
                spacing: 10px;
                height: 44px;
                VerticalLayout {
                    alignment: center;
                    Logo { }
                }
                Text {
                    text: "Wutils";
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Theme.text;
                }
            }

            search := LineEdit {
                placeholder-text: "Find a setting";
                edited(text) => { root.search-changed(text); }
            }
            Rectangle { height: 10px; }

            for page[i] in root.pages: NavItem {
                icon: page.icon;
                title: page.title;
                selected: !root.searching && i == root.current-page;
                clicked => {
                    search.text = "";
                    root.page-selected(i);
                }
            }

            Rectangle { vertical-stretch: 1; }
            Text {
                text: "Version " + root.version;
                font-size: 11px;
                color: Theme.text-secondary;
                horizontal-alignment: left;
            }
        }

        // Content
        VerticalLayout {
            padding-top: 22px;
            padding-left: 12px;
            spacing: 14px;
            horizontal-stretch: 1;

            Text {
                text: root.heading;
                font-size: 28px;
                font-weight: 600;
                color: Theme.text;
            }

            if root.banner.visible: HorizontalLayout {
                padding-right: 28px;
                BannerBar {
                    banner: root.banner;
                    action => { root.banner-action(); }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    padding-right: 28px;
                    padding-bottom: 28px;

                    for item in root.items: ItemView {
                        item: item;
                        show-page: root.searching;
                        checked <=> item.checked;
                        current <=> item.current;
                        toggled(v) => { root.toggled(item.id, v); }
                        selected(i) => { root.choice-selected(item.id, i); }
                        action => { root.action(item.id); }
                    }

                    if root.items.length == 0: Text {
                        text: "No settings match your search.";
                        font-size: 13px;
                        color: Theme.text-secondary;
                    }
                }
            }
        }
    }
}
